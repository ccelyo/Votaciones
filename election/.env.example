# PostgreSQL «Elections» (también se acepta DATABASE_URL).
ELECTION_DATABASE_URL=postgresql://elections:elections@localhost:5433/elections

# RabbitMQ. Vacío desactiva la publicación (los eventos quedan en outbox_events).
ELECTION_RABBITMQ_URI=amqp://guest:guest@localhost:5672/%2f
ELECTION_EXCHANGE=election.events
ELECTION_AUTO_CLOSE=true

# JWT HS256 de Auth: mismo secreto que GATEWAY_JWT_SECRET.
ELECTION_JWT_SECRET=
ELECTION_JWT_ISSUER=
ELECTION_JWT_AUDIENCE=
# SOLO DESARROLLO: acepta X-Dev-User / X-Dev-Roles sin token.
ELECTION_DEV_AUTH=false

# Llaves. ELECTION_URN_KEK: 32 bytes en base64url; vacío = se crea keys/urn_kek.bin.
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
ELECTION_KEYS_DIR=./keys
ELECTION_URN_KEK=
ELECTION_URN_KEY_BITS=3072

ELECTION_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
