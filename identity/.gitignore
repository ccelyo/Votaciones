# ──────────────────────────────────────────────────────────────────────────────
# uv & Environment Specifics
# ──────────────────────────────────────────────────────────────────────────────
.venv/
.uv/

# Do NOT ignore uv.lock — always commit it for deterministic builds!
# !uv.lock

# Keep .python-version tracked so team members use the exact same Python version
# !.python-version

# ──────────────────────────────────────────────────────────────────────────────
# Python Build and Cache Artifacts
# ──────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ──────────────────────────────────────────────────────────────────────────────
# Environment Variables & Secrets (Crucial)
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ──────────────────────────────────────────────────────────────────────────────
# IDEs and OS Files
# ──────────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

