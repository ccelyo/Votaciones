# ──────────────────────────────────────────────────────────────────────────────
# Servicio identity (Python). Copia este archivo a .env y ajusta los valores.
# Nunca versiones el .env real.
# ──────────────────────────────────────────────────────────────────────────────

# [OBLIGATORIA] PostgreSQL de la zona de identidad (también se acepta IDENTITY_DATABASE_URL).
# Acepta postgresql:// o postgres://; internamente se usa el driver psycopg 3.
# Cargar el esquema una vez sobre la base vacía:  psql "$DATABASE_URL" -f schema.sql
# Docker Compose:  postgresql://votaciones:CLAVE@postgres:5432/votaciones
# Cloud SQL:       postgresql://votaciones:CLAVE@10.20.0.3:5432/votaciones?sslmode=require
DATABASE_URL=postgresql://votaciones:CAMBIAR_CLAVE@postgres:5432/votaciones

# Crear tablas al arrancar a partir de los modelos (solo desarrollo; la fuente de verdad
# es schema.sql). En despliegue: false.
IDENTITY_AUTO_CREATE_TABLES=false

# [OBLIGATORIA en despliegue] Dirección host:puerto del gRPC interno de ballot
# (defecto: 127.0.0.1:9091, que dentro de un contenedor no llega a ballot).
# Docker Compose:  ballot:9091
IDENTITY_BALLOT_GRPC_ADDR=ballot:9091

# Canal TLS hacia ballot (true en Cloud Run, donde la dirección es ballot-XXXX.run.app:443).
IDENTITY_BALLOT_GRPC_TLS=false

# Tiempo máximo por llamada gRPC a ballot, en segundos (defecto: 5).
IDENTITY_BALLOT_GRPC_TIMEOUT_SECONDS=5

# Directorio de las claves privadas (RSA de tokens y Ed25519 de parámetros).
# Se generan al primer arranque si no existen. Debe ser un volumen persistente:
# si se pierden, las elecciones ya registradas en ballot dejan de verificar.
# La imagen Docker ya usa /app/keys.
IDENTITY_KEYS_DIR=/app/keys

# Orígenes CORS permitidos (URL del frontend), separados por coma.
# Defecto: http://localhost:3000,http://127.0.0.1:3000
IDENTITY_ALLOWED_ORIGINS=https://votaciones.example.com,http://localhost:3000

# Autenticación simulada con cabeceras X-Dev-User / X-Dev-Roles.
# SOLO desarrollo y pruebas. En despliegue: false.
IDENTITY_DEV_AUTH=false

# Código MFA de demostración del Prototype 1. Cámbialo en cualquier entorno compartido.
IDENTITY_MFA_CODE=123456

# Vigencia del challenge MFA, en segundos (defecto: 300).
IDENTITY_MFA_CHALLENGE_TTL_SECONDS=300

# Vigencia de la sesión autenticada, en segundos (defecto: 3600).
IDENTITY_SESSION_TTL_SECONDS=3600
