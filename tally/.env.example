# Servicio tally (Go). Copia a .env solo para desarrollo local.
# Nunca versiones una clave privada real de urna.

TALLY_HTTP_ADDR=:8092
BALLOT_URL=http://localhost:8080
BALLOT_TALLY_TOKEN=dev-tally-token
TALLY_RABBITMQ_URI=amqp://guest:guest@localhost:5672/
TALLY_EXCHANGE=tally.events

# P1 guarda la opción en claro; pon "false" cuando el cliente cifre de verdad.
TALLY_ALLOW_PLAINTEXT=true

# Clave RSA de la urna (PEM, DER o base64). Alternativa: TALLY_PRIVATE_KEY_FILE.
# TALLY_PRIVATE_KEY=
# TALLY_PRIVATE_KEY_FILE=./urna.pem

TALLY_HTTP_TIMEOUT=30s
TALLY_PUBLISH_ATTEMPTS=5
