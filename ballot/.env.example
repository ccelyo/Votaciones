# ──────────────────────────────────────────────────────────────────────────────
# Servicio ballot (Go). Copia este archivo a .env y ajusta los valores.
# Nunca versiones el .env real: contiene la clave privada de los recibos.
# ──────────────────────────────────────────────────────────────────────────────

# [OBLIGATORIA] Clave privada Ed25519 que firma los recibos de voto.
# 64 bytes (semilla de 32 + clave pública de 32) en base64 o base64url.
# NO uses bytes aleatorios (`openssl rand 64`): la mitad pública no coincidiría
# con la semilla y las firmas no verificarían. Genérala así:
#   python -c "import base64;from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K;k=K.generate();print(base64.b64encode(k.private_bytes_raw()+k.public_key().public_bytes_raw()).decode())"
# En producción guárdala en un gestor de secretos (p. ej. GCP Secret Manager).
BALLOT_RECEIPT_PRIVATE_KEY=CAMBIAR_POR_CLAVE_GENERADA

# [Recomendada en despliegue] MongoDB. Debe ser un replica set (las transacciones lo exigen).
# Si se deja vacía, elecciones y papeletas se guardan en memoria y se pierden al reiniciar.
# Docker Compose:   mongodb://mongo:27017/?replicaSet=rs0&directConnection=true
# Atlas:            mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0&directConnection=true

# Base de datos de MongoDB (defecto: votaciones).
MONGODB_DATABASE=votaciones

# API HTTP pública para el navegador (defecto: :8080).
# Si se define PORT (Cloud Run lo fija solo), tiene prioridad sobre esta variable.
BALLOT_HTTP_ADDR=:8080
# PORT=8080

# API admin gRPC interna que consume identity (defecto en el binario: 127.0.0.1:9091;
# la imagen Docker ya usa 0.0.0.0:9091). No la publiques a internet: aún no tiene mTLS.
BALLOT_GRPC_ADDR=0.0.0.0:9091

# Servir el gRPC admin en el mismo puerto que la API HTTP (cleartext HTTP/2), en vez
# de BALLOT_GRPC_ADDR. Necesario en Cloud Run (un solo puerto; desplegar con --use-http2).
# Ojo: el gRPC admin aún no tiene autenticación y queda tan expuesto como la API HTTP.
# BALLOT_SERVE_GRPC_ON_HTTP=true

# Orígenes CORS permitidos para la API HTTP, separados por coma (defecto: ninguno).
# Pon aquí la URL pública del frontend.
BALLOT_ALLOWED_ORIGINS=https://votaciones.example.com,http://localhost:3000
