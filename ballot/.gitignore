# Descomenta si prefieres regenerarlo en CI.
# internal/pb/

# ── Debug ─────────────────────────────────
__debug_bin*
*.prof
*.pprof

# ── Editores y sistema ────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
