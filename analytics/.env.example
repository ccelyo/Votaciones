# ──────────────────────────────────────────────────────────────────────────────
# Servicio analytics (Rust). Copia este archivo a .env y ajusta los valores.
# ──────────────────────────────────────────────────────────────────────────────

# API HTTP (defecto: 0.0.0.0:8090). Si se define PORT (Cloud Run), tiene prioridad.
ANALYTICS_HTTP_ADDR=0.0.0.0:8090

# MongoDB «Results», exclusiva de analytics (no comparte base con ballot).
ANALYTICS_MONGODB_URI=mongodb://mongo-results:27017
ANALYTICS_MONGODB_DATABASE=results

# RabbitMQ. El vhost por defecto «/» va codificado como %2f.
ANALYTICS_RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672/%2f

# Mensajes sin confirmar que el consumidor tiene a la vez (defecto: 16).
ANALYTICS_PREFETCH=16

# Nivel de logs (formato JSON): error, warn, info, debug.
RUST_LOG=info
